grafana/plugins/
grafana/grafana.zip

# === Python ===
__pycache__/
*.pyc
*.pyo
*.pyc
*.egg-info/
.venv/
venv/
*.egg

# === Node.js ===
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm/
.npmrc

# === Build artifacts ===
dist/
build/
.next/
.nuxt/
out/
*.tsbuildinfo

# === IDE / OS ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# === 大文件 / 二进制 ===
*.zip
*.tar.gz
