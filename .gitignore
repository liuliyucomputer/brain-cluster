# ============================================================
# Brain Cluster — .gitignore
# 只追踪源码，忽略一切依赖、构建产物、运行时数据
# ============================================================

# === 运行时产物 ===
output/logs/
output/memory/
output/reports/
output/artifacts/
output/reviews/
output/.letta/

# === Grafana 二进制 ===
grafana/grafana-v11.6.0/
grafana/data/
grafana/plugins/
grafana/grafana.zip

# === Python ===
__pycache__/
*.pyc
*.pyo
*.pyc
*.egg-info/
.venv/
venv/
*.egg

# === Node.js ===
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm/
.npmrc

# === Build artifacts ===
dist/
build/
.next/
.nuxt/
out/
*.tsbuildinfo

# === IDE / OS ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# === 大文件 / 二进制 ===
*.zip
*.tar.gz
*.7z
*.rar
*.exe
*.dll
*.so
*.dylib
*.bin
*.pth
*.pt
*.safetensors
*.ckpt
*.onnx

# === 日志 ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === 特定目录 ===
eyes/MoneyPrinterTurbo/resource/
eyes/presenton/servers/
eyes/presenton/eng.traineddata
letta/sync_*.json

# === Coverage / Test ===
coverage/
.nyc_output/
.pytest_cache/
.cypress/

# === Docker ===
.docker/
docker-compose.override.yml
